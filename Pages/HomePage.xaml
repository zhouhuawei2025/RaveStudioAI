<UserControl x:Class="RaveStudioAI.Pages.HomePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="42">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel>
                <TextBlock Text="Rave Studio AI" FontSize="32" FontWeight="SemiBold" Foreground="#26324A" />
                <TextBlock Text="请先上传系统导出的 Rave SDS文件，后续功能将以此文件为准。"
                           Margin="0,9,0,0" FontSize="15" Foreground="#6C7892" />
            </StackPanel>

            <Border Grid.Row="1" Margin="0,28,0,0" Padding="28" Background="White" CornerRadius="8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="当前 SDS" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding SdsPath, TargetNullValue=尚未上传}" Margin="0,10,0,0"
                                   Foreground="#66728A" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding LoadedAtText, StringFormat=加载时间：{0}}" Margin="0,6,0,0" Foreground="#8892A8" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="上传已确认的 SDS" Margin="24,0,0,0"
                            VerticalAlignment="Center" Style="{StaticResource ButtonPrimary}" Click="UploadSds_Click" />
                </Grid>
            </Border>

            <UniformGrid Grid.Row="2" Columns="3" Margin="0,18,0,0">
                <Border Background="White" CornerRadius="8" Padding="24" Margin="0,0,12,0">
                    <StackPanel><TextBlock Text="Forms" Foreground="#6C7892" /><TextBlock Text="{Binding FormCount}" FontSize="30" FontWeight="Bold" Margin="0,6,0,0" /></StackPanel>
                </Border>
                <Border Background="White" CornerRadius="8" Padding="24" Margin="6,0">
                    <StackPanel><TextBlock Text="Fields" Foreground="#6C7892" /><TextBlock Text="{Binding FieldCount}" FontSize="30" FontWeight="Bold" Margin="0,6,0,0" /></StackPanel>
                </Border>
                <Border Background="White" CornerRadius="8" Padding="24" Margin="12,0,0,0">
                    <StackPanel><TextBlock Text="Folders" Foreground="#6C7892" /><TextBlock Text="{Binding FolderCount}" FontSize="30" FontWeight="Bold" Margin="0,6,0,0" /></StackPanel>
                </Border>
            </UniformGrid>
        </Grid>
    </ScrollViewer>
</UserControl>
