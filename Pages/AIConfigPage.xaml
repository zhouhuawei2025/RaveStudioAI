<UserControl x:Class="RaveStudioAI.Pages.AIConfigPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hc="https://handyorg.github.io/handycontrol">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="42">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel>
                <TextBlock Text="AI 配置" FontSize="28" FontWeight="SemiBold" Foreground="#26324A" />
                <TextBlock Text="可预设多个 AI 服务。应用当前配置后，下一次 AI 请求立即使用该配置。"
                           Margin="0,8,0,0" Foreground="#6C7892" />
            </StackPanel>

            <Border Grid.Row="1" Margin="0,26,0,0" Padding="28" Background="White" CornerRadius="8">
                <Grid MaxWidth="760" HorizontalAlignment="Left">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="440" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="选择配置" VerticalAlignment="Center" Margin="0,0,12,14" />
                    <ComboBox x:Name="ProfileComboBox" Grid.Row="0" Grid.Column="1" Margin="0,0,0,14"
                              ItemsSource="{Binding Profiles}" DisplayMemberPath="Name"
                              SelectionChanged="ProfileComboBox_SelectionChanged" />
                    <Button Grid.Row="0" Grid.Column="2" Content="新增" Margin="10,0,0,14" Click="AddProfile_Click" 
                            Style="{StaticResource ButtonSuccess.Small}"/>

                    <TextBlock Grid.Row="1" Text="配置名称" VerticalAlignment="Center" Margin="0,0,12,14" />
                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding SelectedProfile.Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,14" />

                    <TextBlock Grid.Row="2" Text="服务地址 URL" VerticalAlignment="Center" Margin="0,0,12,14" />
                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding SelectedProfile.Url, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,14" />

                    <TextBlock Grid.Row="3" Text="模型 Model" VerticalAlignment="Center" Margin="0,0,12,14" />
                    <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding SelectedProfile.Model, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,14" />

                    <TextBlock Grid.Row="4" Text="API Key" VerticalAlignment="Center" Margin="0,0,12,14" />
                    <PasswordBox x:Name="ApiKeyPasswordBox" Grid.Row="4" Grid.Column="1" Margin="0,0,0,14" PasswordChanged="ApiKeyPasswordBox_PasswordChanged" />

                    <TextBlock Grid.Row="5" Text="批次大小" VerticalAlignment="Center" Margin="0,0,12,14" />
                    <TextBox Grid.Row="5" Grid.Column="1" Width="120" HorizontalAlignment="Left" Margin="0,0,0,14"
                             Text="{Binding SelectedProfile.BatchSize, UpdateSourceTrigger=PropertyChanged}" />

                    <StackPanel Grid.Row="6" Grid.Column="1" Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Content="应用当前配置" Margin="0,0,10,0" Click="ApplyProfile_Click" />
                        <Button Content="保存当前配置" Margin="0,0,10,0" Click="SaveProfiles_Click" />
                        <Button x:Name="TestConnectionButton" Content="测试连接" Margin="0,0,10,0"
                                Click="TestConnection_Click" />
                        <Button Content="删除当前配置" Click="DeleteProfile_Click" />
                    </StackPanel>
                </Grid>
            </Border>

            <TextBlock Grid.Row="2" x:Name="CurrentConfigText" Margin="0,18,0,0"
                       Foreground="#4464E8" FontWeight="SemiBold" />
        </Grid>
    </ScrollViewer>
</UserControl>
