<UserControl x:Class="RaveStudioAI.Pages.EditCheckPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,16">
            <TextBlock Text="Edit Check Studio" FontSize="28" FontWeight="SemiBold" Foreground="#26324A" />
            <TextBlock x:Name="SdsStatusText" Margin="0,7,0,0" Foreground="#6C7892"
                       Text="请先从项目入口上传人工确认的 SDS。" />
        </StackPanel>

        <TabControl Grid.Row="1">
            <TabItem Header="OpenQuery 批量生成">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /><RowDefinition Height="2*" /><RowDefinition Height="Auto" /><RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <Button Content="上传 Query Excel" Padding="16,7" Style="{StaticResource ButtonPrimary}" Click="UploadQueries_Click" />
                        <Button x:Name="RunQueriesButton" Content="逐条调用 AI 生成" Padding="16,7" Margin="10,0,0,0"
                                Style="{StaticResource ButtonSuccess}" Click="RunQueries_Click" />
                        <Button Content="清空" Padding="16,7" Margin="10,0,0,0" Click="ClearQueries_Click" />
                        <TextBlock x:Name="QueryProgressText" Margin="18,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding Queries}" AutoGenerateColumns="False" CanUserAddRows="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="QueryOID" Binding="{Binding QueryOid}" Width="120" />
                            <DataGridTextColumn Header="FolderOID" Binding="{Binding FolderOid}" Width="100" />
                            <DataGridTextColumn Header="FormOID" Binding="{Binding FormOid}" Width="100" />
                            <DataGridTextColumn Header="FieldOID" Binding="{Binding FieldOid}" Width="110" />
                            <DataGridTextColumn Header="LogicText" Binding="{Binding LogicText}" Width="*" />
                            <DataGridTextColumn Header="Message" Binding="{Binding MessageText}" Width="*" />
                            <DataGridCheckBoxColumn Header="Error" Binding="{Binding HasError}" Width="60" IsReadOnly="True" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <DockPanel Grid.Row="2" Margin="0,10,0,7">
                        <Button DockPanel.Dock="Right" Content="复制结果" Padding="14,5" Click="CopyQueryResult_Click" />
                        <TextBlock Text="QuickEdit 结果" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </DockPanel>
                    <TextBox Grid.Row="3" x:Name="QueryResultTextBox" AcceptsReturn="True" TextWrapping="NoWrap"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="Consolas" />
                </Grid>
            </TabItem>

            <TabItem Header="SetDataPointVisible 批量生成">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /><RowDefinition Height="2*" /><RowDefinition Height="Auto" /><RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <Button Content="上传 Blind Excel" Padding="16,7" Style="{StaticResource ButtonPrimary}" Click="UploadBlinds_Click" />
                        <Button Content="本地批量生成" Padding="16,7" Margin="10,0,0,0"
                                Style="{StaticResource ButtonSuccess}" Click="RunBlinds_Click" />
                        <Button Content="清空" Padding="16,7" Margin="10,0,0,0" Click="ClearBlinds_Click" />
                        <TextBlock x:Name="BlindProgressText" Margin="18,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding Blinds}" AutoGenerateColumns="False" CanUserAddRows="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="BlindOID" Binding="{Binding BlindOid}" Width="120" />
                            <DataGridTextColumn Header="FolderOID" Binding="{Binding FolderOid}" Width="100" />
                            <DataGridTextColumn Header="FormOID" Binding="{Binding FormOid}" Width="100" />
                            <DataGridTextColumn Header="FieldOID" Binding="{Binding FieldOid}" Width="*" />
                            <DataGridTextColumn Header="LogicText" Binding="{Binding LogicText}" Width="2*" />
                            <DataGridCheckBoxColumn Header="Error" Binding="{Binding HasError}" Width="60" IsReadOnly="True" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <DockPanel Grid.Row="2" Margin="0,10,0,7">
                        <Button DockPanel.Dock="Right" Content="复制结果" Padding="14,5" Click="CopyBlindResult_Click" />
                        <TextBlock Text="QuickEdit 结果" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </DockPanel>
                    <TextBox Grid.Row="3" x:Name="BlindResultTextBox" AcceptsReturn="True" TextWrapping="NoWrap"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="Consolas" />
                </Grid>
            </TabItem>

            <TabItem Header="ECS 手动创建">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/><RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/><RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/><RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <WrapPanel Margin="0,0,0,8">
                        <TextBlock Text="条件步骤" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,16,0"/>
                        <Button Content="添加数据点" Padding="12,5" Click="AddEcsDataPoint_Click"/>
                        <Button Content="添加常量" Padding="12,5" Margin="7,0,0,0" Click="AddEcsConstant_Click"/>
                        <Button Content="添加函数" Padding="12,5" Margin="7,0,0,0" Click="AddEcsFunction_Click"/>
                        <Button Content="dpA = 1" Padding="12,5" Margin="7,0,0,0" Click="AddEcsFieldConstantPreset_Click"/>
                        <Button Content="dpA = dpB" Padding="12,5" Margin="7,0,0,0" Click="AddEcsFieldFieldPreset_Click"/>
                        <Button Content="删除末行" Padding="12,5" Margin="7,0,0,0" Click="RemoveEcsCondition_Click"/>
                    </WrapPanel>
                    <DataGrid x:Name="EcsConditionsGrid" Grid.Row="1" ItemsSource="{Binding EcsConditions}" AutoGenerateColumns="False"
                              CanUserAddRows="False" HorizontalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="100"/>
                            <DataGridTemplateColumn Header="Folder" Width="100"><DataGridTemplateColumn.CellTemplate><DataTemplate><ComboBox IsEditable="True" Text="{Binding FolderOid, UpdateSourceTrigger=PropertyChanged}" ItemsSource="{Binding DataContext.EcsFolders, RelativeSource={RelativeSource AncestorType=UserControl}}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Form" Width="100"><DataGridTemplateColumn.CellTemplate><DataTemplate><ComboBox IsEditable="True" Text="{Binding FormOid, UpdateSourceTrigger=PropertyChanged}" ItemsSource="{Binding DataContext.EcsForms, RelativeSource={RelativeSource AncestorType=UserControl}}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Field" Width="110"><DataGridTemplateColumn.CellTemplate><DataTemplate><ComboBox IsEditable="True" Text="{Binding FieldOid, UpdateSourceTrigger=PropertyChanged}" ItemsSource="{Binding DataContext.EcsFields, RelativeSource={RelativeSource AncestorType=UserControl}}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                            <DataGridTextColumn Header="Variable" Binding="{Binding VariableOid}" Width="90"/>
                            <DataGridTextColumn Header="RecPos" Binding="{Binding RecordPosition}" Width="65"/>
                            <DataGridTextColumn Header="Value" Binding="{Binding StaticValue}" Width="90"/>
                            <DataGridTextColumn Header="DataFormat" Binding="{Binding DataFormat}" Width="105"/>
                            <DataGridTemplateColumn Header="Function" Width="155"><DataGridTemplateColumn.CellTemplate><DataTemplate><ComboBox IsEditable="True" Text="{Binding CheckFunction, UpdateSourceTrigger=PropertyChanged}" ItemsSource="{Binding DataContext.EcsFunctions, RelativeSource={RelativeSource AncestorType=UserControl}}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                            <DataGridTextColumn Header="LogicRecPos" Binding="{Binding LogicalRecordPosition}" Width="95"/>
                            <DataGridTextColumn Header="Scope" Binding="{Binding Scope}" Width="75"/>
                            <DataGridTextColumn Header="OrderBy" Binding="{Binding OrderBy}" Width="85"/>
                            <DataGridTextColumn Header="FormRepNum" Binding="{Binding FormRepeatNumber}" Width="95"/>
                            <DataGridTextColumn Header="FolderRepNum" Binding="{Binding FolderRepeatNumber}" Width="105"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <WrapPanel Grid.Row="2" Margin="0,10,0,8">
                        <TextBlock Text="动作" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,16,0"/>
                        <Button Content="添加动作" Padding="12,5" Click="AddEcsAction_Click"/>
                        <Button Content="删除末行" Padding="12,5" Margin="7,0,0,0" Click="RemoveEcsAction_Click"/>
                        <Button Content="生成 ECS" Padding="14,5" Margin="18,0,0,0" Style="{StaticResource ButtonSuccess}" Click="GenerateEcs_Click"/>
                    </WrapPanel>
                    <DataGrid x:Name="EcsActionsGrid" Grid.Row="3" ItemsSource="{Binding EcsActions}" AutoGenerateColumns="False"
                              CanUserAddRows="False" HorizontalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Folder" Width="100"><DataGridTemplateColumn.CellTemplate><DataTemplate><ComboBox IsEditable="True" Text="{Binding FolderOid, UpdateSourceTrigger=PropertyChanged}" ItemsSource="{Binding DataContext.EcsFolders, RelativeSource={RelativeSource AncestorType=UserControl}}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Form" Width="100"><DataGridTemplateColumn.CellTemplate><DataTemplate><ComboBox IsEditable="True" Text="{Binding FormOid, UpdateSourceTrigger=PropertyChanged}" ItemsSource="{Binding DataContext.EcsForms, RelativeSource={RelativeSource AncestorType=UserControl}}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Field" Width="110"><DataGridTemplateColumn.CellTemplate><DataTemplate><ComboBox IsEditable="True" Text="{Binding FieldOid, UpdateSourceTrigger=PropertyChanged}" ItemsSource="{Binding DataContext.EcsFields, RelativeSource={RelativeSource AncestorType=UserControl}}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                            <DataGridTextColumn Header="Variable" Binding="{Binding VariableOid}" Width="90"/>
                            <DataGridTextColumn Header="RecPos" Binding="{Binding RecordPosition}" Width="65"/>
                            <DataGridTextColumn Header="FormRepNum" Binding="{Binding FormRepeatNumber}" Width="95"/>
                            <DataGridTextColumn Header="FolderRepNum" Binding="{Binding FolderRepeatNumber}" Width="105"/>
                            <DataGridTextColumn Header="LogicRecPos" Binding="{Binding LogicalRecordPosition}" Width="95"/>
                            <DataGridTextColumn Header="Scope" Binding="{Binding Scope}" Width="75"/>
                            <DataGridTextColumn Header="OrderBy" Binding="{Binding OrderBy}" Width="85"/>
                            <DataGridTemplateColumn Header="ActionType" Width="165"><DataGridTemplateColumn.CellTemplate><DataTemplate><ComboBox IsEditable="True" Text="{Binding ActionType, UpdateSourceTrigger=PropertyChanged}" ItemsSource="{Binding DataContext.EcsActionTypes, RelativeSource={RelativeSource AncestorType=UserControl}}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                            <DataGridTextColumn Header="ActionString" Binding="{Binding ActionString}" Width="150"/>
                            <DataGridTextColumn Header="ActionOptions" Binding="{Binding ActionOptions}" Width="260"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <DockPanel Grid.Row="4" Margin="0,10,0,7">
                        <Button DockPanel.Dock="Right" Content="复制结果" Padding="14,5" Click="CopyEcsResult_Click"/>
                        <Button DockPanel.Dock="Right" Content="全部清空" Padding="14,5" Margin="0,0,8,0" Click="ClearEcs_Click"/>
                        <TextBlock Text="ECS 结果" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </DockPanel>
                    <TextBox x:Name="EcsResultTextBox" Grid.Row="5" AcceptsReturn="True" FontFamily="Consolas"
                             HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" TextWrapping="NoWrap"/>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
