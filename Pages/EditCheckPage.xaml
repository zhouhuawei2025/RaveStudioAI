<UserControl x:Class="RaveStudioAI.Pages.EditCheckPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
    </UserControl.Resources>
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,16">
            <TextBlock Text="Edit Check Studio" FontSize="28" FontWeight="SemiBold" Foreground="#26324A" />
            <TextBlock x:Name="SdsStatusText" Margin="0,7,0,0" Foreground="#6C7892"
                       Text="请先从项目入口上传人工确认的 SDS。" />
        </StackPanel>

        <TabControl Grid.Row="1" Style="{StaticResource TabControlInLine}">
            <TabItem Header="OpenQuery生成">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="42" />
                        <RowDefinition Height="5*" />
                        <RowDefinition Height="42" />
                        <RowDefinition Height="3*" />
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <Button Content="上传 Query Excel" Style="{StaticResource ButtonPrimary}" Click="UploadQueries_Click" />
                        <Button x:Name="RunQueriesButton" Content="逐条调用 AI 生成" Margin="10,0,0,0"
                                Style="{StaticResource ButtonSuccess}" Click="RunQueries_Click" />
                        <Button Content="清空数据行" Margin="10,0,0,0" Click="ClearQueryRows_Click" />
                        <TextBlock x:Name="QueryProgressText" Margin="18,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding Queries}" AutoGenerateColumns="False" CanUserAddRows="True" Style="{StaticResource DataGrid.Small}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="QueryOID" Binding="{Binding QueryOid}" Width="120" />
                            <DataGridTextColumn Header="FolderOID" Binding="{Binding FolderOid}" Width="100" />
                            <DataGridTextColumn Header="FormOID" Binding="{Binding FormOid}" Width="100" />
                            <DataGridTextColumn Header="FieldOID" Binding="{Binding FieldOid}" Width="110" />
                            <DataGridTextColumn Header="LogicText" Binding="{Binding LogicText}" Width="*" />
                            <DataGridTextColumn Header="Message" Binding="{Binding MessageText}" Width="*" />
                            <DataGridCheckBoxColumn Header="Error" Binding="{Binding HasError}" Width="60" IsReadOnly="True" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <DockPanel Grid.Row="2" Margin="0,10,0,7">
                        <Button DockPanel.Dock="Right" Content="复制结果" Height="25"
                                Click="CopyQueryResult_Click" 
                                Style="{StaticResource ButtonSuccess.Small}"/>
                        <Button DockPanel.Dock="Right" Content="清空结果" Height="25" Margin="0,0,8,0"
                                Click="ClearQueryResult_Click"/>
                        <TextBlock Text="QuickEdit 结果" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </DockPanel>
                    <TextBox Grid.Row="3" x:Name="QueryResultTextBox" AcceptsReturn="True" TextWrapping="NoWrap"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="Consolas" />
                </Grid>
            </TabItem>

            <TabItem Header="SetDataPointVisible生成">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /><RowDefinition Height="2*" /><RowDefinition Height="Auto" /><RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <Button Content="上传 Blind Excel" Style="{StaticResource ButtonPrimary}" Click="UploadBlinds_Click" />
                        <Button Content="批量生成" Margin="10,0,0,0"
                                Style="{StaticResource ButtonSuccess}" Click="RunBlinds_Click" />
                        <Button Content="清空数据行" Margin="10,0,0,0" Click="ClearBlindRows_Click" />
                        <TextBlock x:Name="BlindProgressText" Margin="18,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding Blinds}" AutoGenerateColumns="False" CanUserAddRows="True" Style="{StaticResource DataGrid.Small}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="BlindOID" Binding="{Binding BlindOid}" Width="120" />
                            <DataGridTextColumn Header="FolderOID" Binding="{Binding FolderOid}" Width="100" />
                            <DataGridTextColumn Header="FormOID" Binding="{Binding FormOid}" Width="100" />
                            <DataGridTextColumn Header="FieldOID" Binding="{Binding FieldOid}" Width="*" />
                            <DataGridTextColumn Header="LogicText" Binding="{Binding LogicText}" Width="2*" />
                            <DataGridCheckBoxColumn Header="Error" Binding="{Binding HasError}" Width="60" IsReadOnly="True" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <DockPanel Grid.Row="2" Margin="0,10,0,7">
                        <Button DockPanel.Dock="Right" Content="复制结果" Height="25" Click="CopyBlindResult_Click" 
                                Style="{StaticResource ButtonSuccess.Small}"/>
                        <Button DockPanel.Dock="Right" Content="清空结果" Height="25" Margin="0,0,8,0"
                                Click="ClearBlindResult_Click"/>
                        <TextBlock Text="QuickEdit 结果" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </DockPanel>
                    <TextBox Grid.Row="3" x:Name="BlindResultTextBox" AcceptsReturn="True" TextWrapping="NoWrap"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="Consolas" />
                </Grid>
            </TabItem>

            <TabItem Header="ECS 手动创建">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/><RowDefinition Height="200"/>
                        <RowDefinition Height="Auto"/><RowDefinition Height="120"/>
                        <RowDefinition Height="Auto"/><RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <WrapPanel Margin="0,0,0,8">
                        <TextBlock Text="条件步骤" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,16,0"/>
                        <Button Content="添加数据点" Padding="12,5" Click="AddEcsDataPoint_Click"/>
                        <Button Content="添加常量" Padding="12,5" Margin="7,0,0,0" Click="AddEcsConstant_Click"/>
                        <Button Content="添加函数" Padding="12,5" Margin="7,0,0,0" Click="AddEcsFunction_Click"/>
                        <Button Content="dpA = 1" Padding="12,5" Margin="7,0,0,0" Click="AddEcsFieldConstantPreset_Click"/>
                        <Button Content="dpA = dpB" Padding="12,5" Margin="7,0,0,0" Click="AddEcsFieldFieldPreset_Click"/>
                        <Button Content="删除末行" Padding="12,5" Margin="7,0,0,0" Click="RemoveEcsCondition_Click"/>
                    </WrapPanel>
                    <DataGrid x:Name="EcsConditionsGrid" Grid.Row="1" ItemsSource="{Binding EcsConditions}" AutoGenerateColumns="False"
                              CanUserAddRows="False" HorizontalScrollBarVisibility="Auto"  Style="{StaticResource DataGrid.Small}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Type" Binding="{Binding Type}" IsReadOnly="True" Width="100"/>
                            <DataGridTemplateColumn Header="Folder" Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox Visibility="{Binding IsDataValue, Converter={StaticResource BoolToVisibility}}" IsEditable="True" Text="{Binding FolderOid, UpdateSourceTrigger=PropertyChanged}" ItemsSource="{Binding DataContext.EcsFolders, RelativeSource={RelativeSource AncestorType=UserControl}}" Style="{StaticResource ComboBox.Small}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Form" Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox Visibility="{Binding IsDataValue, Converter={StaticResource BoolToVisibility}}" IsEditable="True" Text="{Binding FormOid, UpdateSourceTrigger=PropertyChanged}" ItemsSource="{Binding DataContext.EcsForms, RelativeSource={RelativeSource AncestorType=UserControl}}" Style="{StaticResource ComboBox.Small}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Field" Width="110">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox Visibility="{Binding IsDataValue, Converter={StaticResource BoolToVisibility}}" SelectedItem="{Binding FieldOid, UpdateSourceTrigger=PropertyChanged}" ItemsSource="{Binding AvailableFieldOids}" Style="{StaticResource ComboBox.Small}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Variable" Width="90"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBox Visibility="{Binding IsDataValue, Converter={StaticResource BoolToVisibility}}" Text="{Binding VariableOid}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="RecPos" Width="65"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBox Visibility="{Binding IsDataValue, Converter={StaticResource BoolToVisibility}}" Text="{Binding RecordPosition}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Value" Width="90"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBox Visibility="{Binding IsConstant, Converter={StaticResource BoolToVisibility}}" Text="{Binding StaticValue, UpdateSourceTrigger=PropertyChanged}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="DataFormat" Width="115"><DataGridTemplateColumn.CellTemplate><DataTemplate><Grid><ComboBox Visibility="{Binding IsDataValue, Converter={StaticResource BoolToVisibility}}" ItemsSource="{Binding DataContext.EcsDataFormats, RelativeSource={RelativeSource AncestorType=UserControl}}" SelectedItem="{Binding DataFormat, UpdateSourceTrigger=PropertyChanged}"/><TextBox Visibility="{Binding IsConstant, Converter={StaticResource BoolToVisibility}}" Text="{Binding DataFormat}" IsReadOnly="True"/></Grid></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Function" Width="155">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox Visibility="{Binding IsFunction, Converter={StaticResource BoolToVisibility}}" IsEditable="True" Text="{Binding CheckFunction, UpdateSourceTrigger=PropertyChanged}" ItemsSource="{Binding DataContext.EcsFunctions, RelativeSource={RelativeSource AncestorType=UserControl}}" Style="{StaticResource ComboBox.Small}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="LogicRecPos" Width="105"><DataGridTemplateColumn.CellTemplate><DataTemplate><ComboBox Visibility="{Binding IsDataValue, Converter={StaticResource BoolToVisibility}}" ItemsSource="{Binding DataContext.EcsLogicRecordPositions, RelativeSource={RelativeSource AncestorType=UserControl}}" SelectedItem="{Binding LogicalRecordPosition, UpdateSourceTrigger=PropertyChanged}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Scope" Width="80"><DataGridTemplateColumn.CellTemplate><DataTemplate><ComboBox Visibility="{Binding ShowScope, Converter={StaticResource BoolToVisibility}}" ItemsSource="{Binding DataContext.EcsScopes, RelativeSource={RelativeSource AncestorType=UserControl}}" SelectedItem="{Binding Scope}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="OrderBy" Width="90"><DataGridTemplateColumn.CellTemplate><DataTemplate><ComboBox Visibility="{Binding ShowOrderBy, Converter={StaticResource BoolToVisibility}}" ItemsSource="{Binding DataContext.EcsOrderBys, RelativeSource={RelativeSource AncestorType=UserControl}}" SelectedItem="{Binding OrderBy}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="FormRepNum" Width="95"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBox Visibility="{Binding IsDataValue, Converter={StaticResource BoolToVisibility}}" Text="{Binding FormRepeatNumber}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="FolderRepNum" Width="105"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBox Visibility="{Binding IsDataValue, Converter={StaticResource BoolToVisibility}}" Text="{Binding FolderRepeatNumber}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <WrapPanel Grid.Row="2" Margin="0,10,0,8">
                        <TextBlock Text="动作" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,16,0"/>
                        <Button Content="添加动作" Padding="12,5" Click="AddEcsAction_Click"/>
                        <Button Content="删除末行" Padding="12,5" Margin="7,0,0,0" Click="RemoveEcsAction_Click"/>
                        <Button Content="生成 ECS" Padding="14,5" Margin="18,0,0,0" Style="{StaticResource ButtonSuccess}" Click="GenerateEcs_Click"/>
                    </WrapPanel>
                    <DataGrid x:Name="EcsActionsGrid" Grid.Row="3" ItemsSource="{Binding EcsActions}" AutoGenerateColumns="False"
                              CanUserAddRows="False" HorizontalScrollBarVisibility="Auto"  Style="{StaticResource DataGrid.Small}">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Folder" Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox IsEditable="True" Text="{Binding FolderOid, UpdateSourceTrigger=PropertyChanged}" ItemsSource="{Binding DataContext.EcsFolders, RelativeSource={RelativeSource AncestorType=UserControl}}" Style="{StaticResource ComboBox.Small}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Form" Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox IsEditable="True" Text="{Binding FormOid, UpdateSourceTrigger=PropertyChanged}" ItemsSource="{Binding DataContext.EcsForms, RelativeSource={RelativeSource AncestorType=UserControl}}" Style="{StaticResource ComboBox.Small}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Field" Width="110">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox SelectedItem="{Binding FieldOid, UpdateSourceTrigger=PropertyChanged}" ItemsSource="{Binding AvailableFieldOids}" Style="{StaticResource ComboBox.Small}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Variable" Binding="{Binding VariableOid}" Width="90"/>
                            <DataGridTextColumn Header="RecPos" Binding="{Binding RecordPosition}" Width="65"/>
                            <DataGridTextColumn Header="FormRepNum" Binding="{Binding FormRepeatNumber}" Width="95"/>
                            <DataGridTextColumn Header="FolderRepNum" Binding="{Binding FolderRepeatNumber}" Width="105"/>
                            <DataGridTemplateColumn Header="LogicRecPos" Width="105"><DataGridTemplateColumn.CellTemplate><DataTemplate><ComboBox ItemsSource="{Binding DataContext.EcsLogicRecordPositions, RelativeSource={RelativeSource AncestorType=UserControl}}" SelectedItem="{Binding LogicalRecordPosition, UpdateSourceTrigger=PropertyChanged}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Scope" Width="80"><DataGridTemplateColumn.CellTemplate><DataTemplate><ComboBox Visibility="{Binding ShowScope, Converter={StaticResource BoolToVisibility}}" ItemsSource="{Binding DataContext.EcsScopes, RelativeSource={RelativeSource AncestorType=UserControl}}" SelectedItem="{Binding Scope}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="OrderBy" Width="90"><DataGridTemplateColumn.CellTemplate><DataTemplate><ComboBox Visibility="{Binding ShowOrderBy, Converter={StaticResource BoolToVisibility}}" ItemsSource="{Binding DataContext.EcsOrderBys, RelativeSource={RelativeSource AncestorType=UserControl}}" SelectedItem="{Binding OrderBy}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="ActionType" Width="165">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox SelectedItem="{Binding ActionType, UpdateSourceTrigger=PropertyChanged}" ItemsSource="{Binding DataContext.EcsActionTypes, RelativeSource={RelativeSource AncestorType=UserControl}}" Style="{StaticResource ComboBox.Small}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="ActionString" Binding="{Binding ActionString}" Width="150"/>
                            <DataGridTextColumn Header="ActionOptions" Binding="{Binding ActionOptions}" Width="260"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <DockPanel Grid.Row="4" Margin="0,10,0,7">
                        <Button DockPanel.Dock="Right" Height="25" Content="复制结果" Click="CopyEcsResult_Click"
                                Style="{StaticResource ButtonSuccess.Small}"/>
                        <Button DockPanel.Dock="Right" Content="全部清空" Margin="0,0,8,0" Click="ClearEcs_Click"/>
                        <TextBlock Text="ECS 结果" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </DockPanel>
                    <TextBox x:Name="EcsResultTextBox" Grid.Row="5" AcceptsReturn="True" FontFamily="Consolas"
                             HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" TextWrapping="NoWrap"/>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
