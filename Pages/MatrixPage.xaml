<UserControl x:Class="RaveStudioAI.Pages.MatrixPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             Loaded="MatrixPage_Loaded">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,20">
            <TextBlock Text="Matrix Builder" FontSize="28" FontWeight="SemiBold" Foreground="#26324A" />
            <TextBlock Text="读取 Forms/Folders 和 Matrices 场景文件，生成、校验并导出 Rave Matrix。"
                       Margin="0,7,0,0" Foreground="#6C7892" />
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="White" CornerRadius="8" Padding="20">
                <StackPanel>
                    <Button x:Name="UploadTemplateButton" Content="上传 Folders-Forms" Height="38" Width="150"
                            Style="{StaticResource ButtonPrimary}" Click="UploadTemplate_Click" />
                    <Button Content="使用主入口 SDS" Height="34" Width="150" Margin="0,8,0,0"
                            Click="UseCurrentSds_Click" />
                    <TextBlock Text="{Binding FormOids.Count, StringFormat=已读取 {0} 个 Form OID}" Margin="0,13,0,4" />
                    <TextBlock Text="{Binding VisitOids.Count, StringFormat=已读取 {0} 个 Visit OID}" />
                    <TextBlock Text="{Binding TemplatePath}" Margin="0,7,0,22" Foreground="#8892A8"
                               TextWrapping="Wrap" MaxHeight="52" />

                    <Button x:Name="UploadScenarioButton" Content="上传 DM Matrices文件" Height="38" Width="150"
                            Style="{StaticResource ButtonPrimary}" Click="UploadScenario_Click" />
                    <TextBlock Text="{Binding Matrices.Count, StringFormat=已解析 {0} 个 Matrix}" Margin="0,13,0,4" />
                    <TextBlock Text="{Binding ScenarioPath}" Margin="0,7,0,22" Foreground="#8892A8"
                               TextWrapping="Wrap" MaxHeight="52" />

                    <Button x:Name="ExportButton" Content="导出 Matrices" Height="38" Width="150"
                            Style="{StaticResource ButtonSuccess}" Click="Export_Click" />
                    <Button Content="打开输出目录" Height="34" Width="150" Margin="0,8,0,0"
                            Click="OpenOutputFolder_Click" />
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Background="White" CornerRadius="8" Padding="18">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock Text="预览 Matrix" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <ComboBox Width="310" Margin="12,0,0,0" ItemsSource="{Binding Matrices}"
                                      SelectedItem="{Binding SelectedMatrix}" DisplayMemberPath="DisplayName"
                                      SelectionChanged="MatrixSelectionChanged" />
                            <TextBlock Text="{Binding SelectedMatrixSummary}" Margin="16,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <ListBox ItemsSource="{Binding Issues}" DisplayMemberPath="DisplayText"
                                 MaxHeight="90" Margin="0,0,0,10" />
                    </StackPanel>

                    <DataGrid x:Name="MatrixDataGrid" AutoGenerateColumns="False" IsReadOnly="True"
                              EnableRowVirtualization="True" EnableColumnVirtualization="True"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                              ScrollViewer.VerticalScrollBarVisibility="Auto" />
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
