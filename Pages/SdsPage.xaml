<UserControl x:Class="RaveStudioAI.Pages.SdsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,20">
            <TextBlock Text="Field Builder" FontSize="28" FontWeight="SemiBold" Foreground="#26324A" />
            <TextBlock Text="从 CRF Word 提取 Forms、CodeLists 和 Fields。生成结果需要人工复核后，再从项目入口上传。"
                       Margin="0,7,0,0" Foreground="#6C7892" />
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="White" CornerRadius="8" Padding="20">
                <StackPanel>
                    <TextBlock Text="处理步骤" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,16" />
                    <Button x:Name="UploadButton" Content="1  上传并检查 CRF" Width="150" Height="40"
                            Style="{StaticResource ButtonPrimary}" 
                            Click="Upload_Click" />
                    <Button x:Name="FormButton" Content="2  提取 Forms"  Width="150" Height="40" Margin="0,10,0,0"
                            IsEnabled="False" 
                            Click="ExtractForms_Click" />
                    <Button x:Name="CodeListButton" Content="3  AI 提取 CodeLists"  Width="150" Height="40" Margin="0,10,0,0"
                            IsEnabled="False" 
                            Click="ExtractCodeLists_Click" />
                    <Button x:Name="FieldButton" Content="4  AI 提取 Fields"  Width="150" Height="40" Margin="0,10,0,0"
                            IsEnabled="False" 
                            Click="ExtractFields_Click" />
                    <Separator Margin="0,20" />
                    <Button Content="打开输出目录" Height="36" Width="150" Click="OpenOutputFolder_Click" 
                            Style="{StaticResource ButtonSuccess}"/>
                    <!--<TextBlock Text="AI 配置取自左侧“AI 配置”页面，每个批次开始时使用当时选中的配置。"
                               Margin="0,18,0,0" TextWrapping="Wrap" Foreground="#7A859C" />-->
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Background="White" CornerRadius="8" Padding="20">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                        <TextBlock Text="解析详情" FontSize="18" FontWeight="SemiBold" />
                        <ProgressBar x:Name="ProgressBar" Height="5" Margin="0,12,0,0"
                                     IsIndeterminate="True" Visibility="Collapsed" />
                    </StackPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <TextBlock x:Name="LogText" Text="等待上传 CRF Word..." TextWrapping="Wrap"
                                   FontFamily="Consolas" FontSize="13" Foreground="#34405A" />
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
