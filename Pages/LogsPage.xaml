<UserControl x:Class="RaveStudioAI.Pages.LogsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="LogsPage_Loaded">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="日志中心" FontSize="28" FontWeight="SemiBold" Foreground="#26324A" />
            <TextBlock Text="查看各功能模块产生的运行日志。双击文件即可用系统默认程序打开。"
                       Margin="0,7,0,0" Foreground="#6C7892" />
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,20,0,14">
            <TextBlock Text="模块" VerticalAlignment="Center" Margin="0,0,8,0" />
            <ComboBox x:Name="CategoryComboBox" Width="180" SelectionChanged="CategoryChanged">
                <ComboBoxItem Content="全部日志" Tag="All" IsSelected="True" />
                <ComboBoxItem Content="EDC / SDS" Tag="Sds" />
                <ComboBoxItem Content="Matrix" Tag="Matrix" />
                <ComboBoxItem Content="Edit Check" Tag="EditCheck" />
                <ComboBoxItem Content="RWS" Tag="Rws" />
                <ComboBoxItem Content="应用程序" Tag="App" />
            </ComboBox>
            <Button Content="刷新" Padding="18,6" Margin="12,0,0,0" Click="Refresh_Click" />
            <Button Content="打开日志根目录" Padding="18,6" Margin="10,0,0,0" Click="OpenRoot_Click" />
        </StackPanel>

        <Border Grid.Row="2" Background="White" CornerRadius="8" Padding="12">
            <DataGrid x:Name="LogsGrid" AutoGenerateColumns="False" IsReadOnly="True"
                      SelectionMode="Single" MouseDoubleClick="LogsGrid_DoubleClick">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="模块" Binding="{Binding Category}" Width="120" />
                    <DataGridTemplateColumn Header="日志文件" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="{Binding FileName}" HorizontalContentAlignment="Left"
                                        Background="Transparent" BorderThickness="0" Foreground="#4464E8"
                                        Cursor="Hand" Tag="{Binding FullPath}" Click="OpenLog_Click" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="更新时间" Binding="{Binding UpdatedAtText}" Width="170" />
                    <DataGridTextColumn Header="大小" Binding="{Binding SizeText}" Width="100" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
