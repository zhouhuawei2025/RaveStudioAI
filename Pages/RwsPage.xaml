<UserControl x:Class="RaveStudioAI.Pages.RwsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hc="https://handyorg.github.io/handycontrol">
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Border Padding="16" Background="#F6F8FC" CornerRadius="8" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="60"/>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="60"/>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="60"/>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="50"/>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="当前选择:" VerticalAlignment="Center"/>
                <ComboBox x:Name="ProfileComboBox" Grid.Column="1" SelectionChanged="ProfileComboBox_SelectionChanged"/>
                <TextBlock Grid.Column="2" Text="租户名:" Margin="12,0,0,0" VerticalAlignment="Center"/>
                <TextBox x:Name="TenantTextBox" Grid.Column="3"/>
                <TextBlock Grid.Column="4" Text="用户名:" Margin="12,0,0,0" VerticalAlignment="Center"/>
                <TextBox x:Name="UsernameTextBox" Grid.Column="5"/>
                <TextBlock Grid.Column="6" Text="密码:" Margin="12,0,0,0" VerticalAlignment="Center"/>
                <PasswordBox x:Name="PasswordBox" Grid.Column="7"/>
                <StackPanel Grid.Column="8" Orientation="Horizontal" Margin="14,0,0,0">
                    <Button Content="新增租户" Click="NewTenant_Click"/>
                    <Button Content="保存配置" Click="SaveProfile_Click"
                            Margin="8,0,0,0"
                            Style="{StaticResource ButtonSuccess}"/>
                    <Button x:Name="LoginButton" Content="连接 RWS" Margin="8,0,0,0" 
                            Click="Login_Click"
                            Style="{StaticResource ButtonInfo}"/>
                </StackPanel>
            </Grid>
        </Border>

        <TabControl Grid.Row="1" Style="{StaticResource TabControlInLine}">
            <TabItem Header="数据查询">
                <Grid Margin="8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="4,4,16,4">
                            <TextBlock Text="试验" FontWeight="Bold"/>
                            <ComboBox x:Name="StudyComboBox" Margin="0,6,0,12" DisplayMemberPath="DisplayName" SelectionChanged="StudyComboBox_SelectionChanged"/>
                            <TextBlock Text="环境" FontWeight="Bold"/>
                            <TextBox x:Name="EnvironmentTextBox" Margin="0,6,0,12"/>
                            <DockPanel><TextBlock Text="受试者" FontWeight="Bold"/><Button Content="全选/取消" DockPanel.Dock="Right" Click="ToggleSubjects_Click"/></DockPanel>
                            <TextBox x:Name="SubjectSearchTextBox" Margin="0,6,0,0" ToolTip="输入受试者编号筛选" TextChanged="SubjectSearchTextBox_TextChanged"/>
                            <ListBox x:Name="SubjectListBox" Height="190" Margin="0,6,0,12">
                                <ListBox.ItemTemplate><DataTemplate><CheckBox Content="{Binding SubjectKey}" IsChecked="{Binding IsSelected, Mode=TwoWay}"/></DataTemplate></ListBox.ItemTemplate>
                            </ListBox>
                            <DockPanel><TextBlock Text="表单" FontWeight="Bold"/><Button Content="全选/取消" DockPanel.Dock="Right" Click="ToggleForms_Click"/></DockPanel>
                            <TextBox x:Name="FormSearchTextBox" Margin="0,6,0,0" ToolTip="输入 FormOID 筛选" TextChanged="FormSearchTextBox_TextChanged"/>
                            <ListBox x:Name="FormListBox" Height="190" Margin="0,6,0,12">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}">
                                            <TextBlock Text="{Binding FormName}"/>
                                        </CheckBox>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <ComboBox x:Name="DatasetTypeComboBox" SelectedIndex="0"><ComboBoxItem Content="regular"/><ComboBoxItem Content="raw"/></ComboBox>
                            <Button x:Name="DownloadButton" Content="查询数据" Margin="0,12,0,0" Click="Download_Click"/>
                        </StackPanel>
                    </ScrollViewer>
                    <StackPanel Grid.Column="1" Margin="0,4,14,4">
                        <TextBlock Text="历史查询" FontWeight="Bold" Margin="0,0,0,8"/>
                        <TextBlock Text="双击可按原条件重新查询" Foreground="#6C7892" Margin="0,0,0,8"/>
                        <ListBox x:Name="HistoryListBox" MouseDoubleClick="HistoryListBox_MouseDoubleClick">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="2,5">
                                        <TextBlock Text="{Binding HistoryName}" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Summary}" Foreground="#6C7892" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <DockPanel Margin="0,0,0,8">
                            <TextBlock x:Name="DownloadStatusText" Text="请先连接 RWS" VerticalAlignment="Center"/>
                            <Button Content="导出 Excel" DockPanel.Dock="Right" Padding="12,5" Click="ExportData_Click"/>
                        </DockPanel>
                        <DockPanel Grid.Row="1" Margin="0,0,0,8">
                            <Button Content="清空筛选" DockPanel.Dock="Right" Padding="12,5" Margin="8,0,0,0" Click="ClearDatasetFilter_Click"/>
                            <Button Content="筛选" DockPanel.Dock="Right" Padding="12,5" Click="ApplyDatasetFilter_Click"/>
                            <TextBox x:Name="DatasetFilterTextBox" ToolTip="示例：AEYN = '1' and AESEV in ('1','2')"/>
                        </DockPanel>
                        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="预览表单：" FontWeight="Bold" VerticalAlignment="Center"/>
                            <ComboBox x:Name="PreviewFormComboBox" Width="160" DisplayMemberPath="Header"
                                      SelectionChanged="PreviewFormComboBox_SelectionChanged"/>
                            <hc:Pagination x:Name="PreviewPagination" Margin="12,0,0,0" DataCountPerPage="50"
                                           MaxPageCount="1" PageIndex="1" PageUpdated="PreviewPagination_PageUpdated"/>
                            <TextBlock x:Name="PreviewPageInfoText" Margin="12,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <DataGrid x:Name="DataGrid" Grid.Row="3" IsReadOnly="True" AutoGenerateColumns="True" EnableRowVirtualization="True" EnableColumnVirtualization="True"/>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="发送质疑">
                <Grid Margin="8">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Content="上传 Query Excel" Padding="12,5" Click="UploadQueries_Click"/>
                        <TextBlock Text="接收组" Margin="18,0,6,0" VerticalAlignment="Center"/>
                        <TextBox x:Name="RecipientTextBox" Width="150" Text="Site from DM"/>
                        <Button x:Name="SendQueriesButton" Content="逐条发送" Padding="12,5" Margin="8,0,0,0" Click="SendQueries_Click"/>
                        <Button Content="导出全部" Padding="12,5" Margin="8,0,0,0" Click="ExportQueries_Click"/>
                        <Button Content="导出失败" Padding="12,5" Margin="8,0,0,0" Click="ExportFailedQueries_Click"/>
                        <TextBlock x:Name="QueryStatusText" Margin="16,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <DataGrid x:Name="QueryDataGrid" Grid.Row="1" IsReadOnly="True" AutoGenerateColumns="False"
                              EnableRowVirtualization="True" EnableColumnVirtualization="True">
                        <DataGrid.Resources>
                            <Style TargetType="DataGridCell">
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#DCEBFF"/>
                                        <Setter Property="Foreground" Value="#1F2937"/>
                                        <Setter Property="BorderBrush" Value="#7AA7F7"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.Resources>
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Status}" Value="Success">
                                        <Setter Property="Background" Value="#E8F7EF"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="Failed">
                                        <Setter Property="Background" Value="#FBE2E2"/>
                                        <Setter Property="Foreground" Value="#8A1F1F"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="#" Binding="{Binding RowNumber}" Width="60"/>
                            <DataGridTextColumn Header="SiteOID" Binding="{Binding SiteOID}" Width="120"/>
                            <DataGridTextColumn Header="Subject" Binding="{Binding Subject}" Width="100"/>
                            <DataGridTextColumn Header="FolderOID" Binding="{Binding FolderOID}" Width="110"/>
                            <DataGridTextColumn Header="FolderRepeatNumber" Binding="{Binding FolderRepeatNumber}" Width="150"/>
                            <DataGridTextColumn Header="FormOID" Binding="{Binding FormOID}" Width="100"/>
                            <DataGridTextColumn Header="FormRepeatNumber" Binding="{Binding FormRepeatNumber}" Width="150"/>
                            <DataGridTextColumn Header="RecordPosition" Binding="{Binding RecordPosition}" Width="130"/>
                            <DataGridTextColumn Header="FieldOID" Binding="{Binding FieldOID}" Width="120"/>
                            <DataGridTextColumn Header="Data" Binding="{Binding Data}" Width="120"/>
                            <DataGridTextColumn Header="Specify" Binding="{Binding Specify}" Width="120"/>
                            <DataGridTextColumn Header="Query" Binding="{Binding Query}" Width="220"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100"/>
                            <DataGridTextColumn Header="ErrorMessage" Binding="{Binding ErrorMessage}" Width="260"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- 配置详情不再作为可见选项卡；保留隐藏控件供既有配置读写逻辑维护状态。 -->
        <Grid Visibility="Collapsed">
                <Grid Margin="16">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="租户名称" Width="90" VerticalAlignment="Center"/><TextBox x:Name="ProfileNameTextBox" Width="220" IsReadOnly="True"/>
                        <TextBlock Text="预设试验" Width="90" Margin="24,0,0,0" VerticalAlignment="Center"/>
                        <ComboBox x:Name="ConfiguredStudyComboBox" Width="220" IsEditable="True"
                                  SelectionChanged="ConfiguredStudyComboBox_SelectionChanged"/>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,12,0,0">
                        <TextBlock Text="预设环境" Width="90" VerticalAlignment="Center"/>
                        <ComboBox x:Name="ConfiguredEnvironmentComboBox" Width="220" IsEditable="True"
                                  SelectionChanged="ConfiguredEnvironmentComboBox_SelectionChanged"/>
                        <TextBlock Text="生产环境填写或选择 Prod" Foreground="#6C7892" Margin="12,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Grid.Row="2" Text="配置文件会在本机以明文保存密码，请勿提交包含真实密码的配置文件。" Foreground="#B45309" Margin="0,12,0,0"/>
                    <TextBlock Grid.Row="3" Text="预设表单（每行一个，也可用逗号分隔）" Margin="0,18,0,8"/>
                    <TextBox x:Name="ConfiguredFormsTextBox" Grid.Row="4" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
                </Grid>
        </Grid>
    </Grid>
</UserControl>
