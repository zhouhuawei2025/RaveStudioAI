<UserControl x:Class="RaveStudioAI.Pages.SetDataPointVisiblePage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="42"/>
            <RowDefinition Height="2*" MaxHeight="400"/>
            <RowDefinition Height="35"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,16">
            <TextBlock Text="SetDataPointVisible Builder" FontSize="28" FontWeight="SemiBold" Foreground="#26324A"/>
            <TextBlock x:Name="SdsStatusText" Margin="0,7,0,0" Foreground="#6C7892"/>
        </StackPanel>
        <StackPanel Grid.Row="1" Orientation="Horizontal">
            <Button Content="上传并校验" Style="{StaticResource ButtonPrimary}" Click="Upload_Click"/>
            <Button Content="导出校验文件" Margin="10,0,0,0" Click="ExportReview_Click"/>
            <Button x:Name="RunButton" Content="生成 ECS" Margin="10,0,0,0" Style="{StaticResource ButtonSuccess}" Click="Run_Click"/>
            <Button Content="清空数据行" Margin="10,0,0,0" Click="ClearRows_Click"/>
            <TextBlock x:Name="ProgressText" Margin="18,0,0,0" VerticalAlignment="Center"/>
        </StackPanel>
        <DataGrid Grid.Row="2" ItemsSource="{Binding Rows}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="False" >
            <DataGrid.Resources>
                <Style TargetType="DataGridCell">
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Foreground" Value="#111827"/>
                            <Setter Property="Background" Value="#DCEBFF"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.Resources>
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasError}" Value="True">
                            <Setter Property="Background" Value="#FBE2E2"/>
                            <Setter Property="Foreground" Value="#8A1F1F"/>
                        </DataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding HasError}" Value="False"/>
                                <Condition Binding="{Binding HasSuggestion}" Value="True"/>
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Background" Value="#FFF7D6"/>
                            <Setter Property="Foreground" Value="#624B00"/>
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="BlindOID" Binding="{Binding BlindOid}" Width="120" IsReadOnly="True"/>
                <DataGridTextColumn Header="FolderOID" Binding="{Binding FolderOid}" Width="100" IsReadOnly="True"/>
                <DataGridTextColumn Header="FormOID" Binding="{Binding FormOid}" Width="100" IsReadOnly="True"/>
                <DataGridTextColumn Header="FieldOID" Binding="{Binding FieldOid}" Width="150" IsReadOnly="True"/>
                <DataGridTextColumn Header="LogicText" Binding="{Binding LogicText}" Width="240" IsReadOnly="True"/>
                <DataGridTextColumn Header="NormalizedLogicText" Binding="{Binding NormalizedLogicText}" Width="280" IsReadOnly="True"/>
                <DataGridTextColumn Header="校验信息" Binding="{Binding ValidationMessage}" Width="260" IsReadOnly="True"/>
                <DataGridCheckBoxColumn Header="Error" Binding="{Binding HasError, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="60" IsReadOnly="False"/>
            </DataGrid.Columns>
        </DataGrid>
        <DockPanel Grid.Row="3" Margin="0,10,0,7">
            <Button DockPanel.Dock="Right" Content="复制结果" Click="Copy_Click" Style="{StaticResource ButtonSuccess.Small}"/>
            <Button DockPanel.Dock="Right" Content="清空结果" Margin="0,0,8,0" Click="ClearResult_Click"/>
            <TextBlock Text="QuickEdit 结果" FontWeight="SemiBold" VerticalAlignment="Center"/>
        </DockPanel>
        <TextBox x:Name="ResultTextBox" Grid.Row="4" AcceptsReturn="True" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="Consolas"/>
    </Grid>
</UserControl>
